{
  "name": "drive-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Google Drive clone MVP (Node/Express/TS, Postgres, MinIO)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "cleanup-stale-uploads": "ts-node scripts/cleanup-stale-uploads.ts",
    "purge-trash": "ts-node scripts/purge-trash.ts",
    "create-admin": "ts-node scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:all": "npm run build:frontend && npm run build"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/s3-request-presigner": "^3.687.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
