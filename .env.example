NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://drive_clone:changeme@localhost:5432/drive_clone

# JWT
JWT_ACCESS_SECRET=changeme-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=changeme-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO / S3-compatible storage — internal address (private network only,
# the app server uses this for admin operations)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=drive-clone

# Public URL used ONLY to sign presigned upload/download URLs — this is
# the hostname a browser actually hits, through Nginx Proxy Manager.
# Must NOT be the same as MINIO_ENDPOINT unless MinIO really is directly
# internet-reachable at that host. See README "Exposing MinIO" section.
MINIO_PUBLIC_URL=https://s3.yourdomain.com

# Multipart upload tuning
UPLOAD_PART_SIZE_BYTES=104857600
MAX_UPLOAD_SIZE_BYTES=21474836480
PRESIGN_UPLOAD_TTL_SECONDS=21600
PRESIGN_DOWNLOAD_TTL_SECONDS=3600
STALE_UPLOAD_CLEANUP_HOURS=48
TRASH_RETENTION_DAYS=30

# Invites
INVITE_TTL_HOURS=72
